import time
from datetime import timedelta

def timer_decore(fn):
    def wrapper(*args, **kwargs):
        start_time = time.perf_counter()
        #time.sleep(2) я использовал это для проверки действия таймера
        ret_val = fn(*args, **kwargs)
        end_time = time.perf_counter() - start_time
        print(f"Функция выполнена, время выполнения: {timedelta(seconds=int(end_time))}")
        return ret_val
    return wrapper;

@timer_decore
def summa(a,b):
    print(a + b)
a = 5
b = 6
